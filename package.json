{
  "name": "orbital",
  "productName": "Orbital",
  "version": "1.18.0",
  "description": "Get work done from orbit — a native Windows cockpit for running many interactive coding-agent sessions side by side.",
  "main": "./out/main/index.js",
  "author": "Jim Buck",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "prepare": "husky",
    "build:cli": "esbuild src/cli/orbital.ts --bundle --platform=node --target=node20 --format=cjs --outfile=resources/cli/orbital.js",
    "start": "npm run build:cli && electron-vite dev",
    "dev": "npm run build:cli && electron-vite dev",
    "preview": "npm run build:cli && electron-vite preview",
    "build": "npm run build:cli && electron-vite build",
    "rebuild": "electron-rebuild -f -w better-sqlite3,node-pty",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "make": "npm run build && electron-builder"
  },
  "overrides": {
    "node-gyp": "^11.0.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.3.0",
    "electron-updater": "^6.8.9",
    "ignore": "^7.0.5",
    "marked": "^18.0.5",
    "node-pty": "^1.0.0",
    "picomatch": "^4.0.2",
    "shiki": "^4.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@electron/rebuild": "^3.7.0",
    "@eslint/js": "^9.13.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.0",
    "@types/picomatch": "^3.0.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.460.0",
    "patch-package": "^8.0.1",
    "playwright-core": "^1.61.1",
    "postinstall-postinstall": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.10",
    "vitest": "^3.2.7",
    "zustand": "^5.0.1"
  }
}
